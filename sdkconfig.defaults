# ESP32-FIDO2 Project Configuration
#
CONFIG_TINYUSB_TASK_STACK_SIZE=16384

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Optimise the crypto/protocol code: -Og made RSA/ECC operations several
# times slower and contributed to PC/SC timeouts during key generation.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# app_main() scans the flash filesystem and initialises OTP storage; the
# default 3584-byte stack is tight for that work.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_PERF=y
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

# Disable USB-Serial-JTAG console (keep UART for development).
# The previous three "=n" lines did not work: ESP_CONSOLE_SECONDARY is a
# choice, so the secondary console has to be switched to NONE explicitly.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Also power down the USB-Serial-JTAG module clock at startup.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# mbedTLS
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
# ESP32-S3 has no dedicated ECC or GCM accelerator; these symbols were
# no-ops here (SOC_ECC_SUPPORTED / SOC_AES_SUPPORT_GCM are not set).
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_DES_C=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_SHA512_C=y
CONFIG_MBEDTLS_TLS_DISABLED=y

# Disable unused features
CONFIG_ESP_TLS_USE_DS_PERIPHERAL=n
CONFIG_MBEDTLS_SHA3_C=y
